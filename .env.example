# 必須 (秘密)
# TORO-Server/TORO-Wiki の Contents を読み書きできるトークン (Fine-grained PAT。対象はこのリポジトリだけにする)
GITHUB_TOKEN=

# 必須 (既定値なし。未設定なら起動時にエラーで止まる)
# トークンの確認を頼む、認証サービスの内部の URL。公開しない (トンネルに載せない) 口で、同じネットワークからだけ届くようにする
AUTH_INTERNAL_URL=http://auth.internal.example:8081
# Minecraft サーバー (入り口のプロキシ) の稼働確認の接続先 (host:port)
MC_STATUS_ADDR=mc.internal.example:25565

# 任意。既定は本番の値
# GITHUB_OWNER=TORO-Server
# GITHUB_REPO=TORO-Wiki
# GITHUB_BRANCH=main
# Cookie 付きで API を呼べる Origin (カンマ区切り)
# CORS_ORIGINS=https://wiki.torosaba.net
# PUBLIC_AUTH_URL=https://auth.torosaba.net
# PUBLIC_API_URL=https://api.torosaba.net
# PUBLIC_MCP_URL=https://mcp.torosaba.net
# PUBLIC_WIKI_URL=https://wiki.torosaba.net
# MC_STATUS_HOST=torosaba.net
# PORT=8080

# 地図 API (/map/v1/*。Dynmap の DB を読んで返す)。MAP_DB_HOST を決めたときだけ動く (決めなければ /map/v1/* は 404)
# Dynmap の DB (TiDB) の接続先。読み取り専用の利用者を使う (このサービスは SELECT しか発行しない)
# MAP_DB_HOST=db.internal.example
# MAP_DB_PORT=4000
# MAP_DB_USER=
# 秘密。空でもよい (パスワードなしの開発用の DB)
# MAP_DB_PASSWORD=
# Dynmap のデータベース名 (表の接頭辞は dynmap_ 固定)
# MAP_DYNMAP_DATABASE=dynmap
# dynmap-live (TORO-Core) からの位置を受ける、内部専用の待受 (host:port)。決めなければ待受を起動しない。
# 公開の待受 (PORT) の先は Tunnel に載るので、/live/plugin はここにだけ置く。Tunnel の規則に載せない
# MAP_LIVE_ADDR=0.0.0.0:8081
# 秘密。dynmap-live が X-Toro-Token で送る合言葉。空なら、どんな値も通さない
# MAP_LIVE_TOKEN=
