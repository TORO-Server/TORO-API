{
  "openapi": "3.1.0",
  "info": {
    "title": "TORO Server API",
    "version": "1.0.0",
    "description": "TORO Server の REST API。Wiki の原稿の読み取り・検索・コミットと、Minecraft サーバーの稼働状態の確認ができます。書き込みには auth.torosaba.net で発行した Bearer トークンが必要です。ChatGPT Actions や Gemini Extensions から利用できます。",
    "contact": {
      "name": "TORO Server Administration",
      "url": "https://wiki.torosaba.net"
    }
  },
  "servers": [
    {
      "url": "{{SERVER_URL}}",
      "description": "TORO Server API"
    }
  ],
  "paths": {
    "/docs/raw": {
      "get": {
        "summary": "Wiki ドキュメントの Markdown 原稿取得",
        "operationId": "getWikiDocRaw",
        "description": "GitHub リポジトリ上の指定されたパスの Markdown 本文および SHA ハッシュを取得します。",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ドキュメントの相対パス（例: \"07_System/AIクライアントの接続方法.md\"）"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "raw"
              ]
            },
            "description": "返却フォーマット。raw を指定すると text/markdown 本文のみを返します。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "sha": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer"
                    }
                  }
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "指定されたファイルが存在しません"
          }
        }
      }
    },
    "/docs/list": {
      "get": {
        "summary": "Wiki ドキュメントの一覧",
        "operationId": "listWikiDocs",
        "description": "docs/ の下の Markdown 原稿のパスを一覧します。",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "パスの先頭がこの文字列のものだけに絞ります（例: \"07_System\"）。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "pages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/docs/search": {
      "get": {
        "summary": "Wiki ドキュメントの全文検索",
        "operationId": "searchWikiDocs",
        "description": "語をすべて含む原稿のパスを、よく一致する順に返します。語は空白で区切ります。",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "検索する語（空白区切り）。512 バイトまで、異なる語は 16 個まで。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "hits": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "検索の文字列が長すぎます"
          },
          "503": {
            "description": "検索の準備ができていません"
          }
        }
      }
    },
    "/server/status": {
      "get": {
        "summary": "Minecraft サーバーの稼働状態",
        "operationId": "getServerStatus",
        "description": "TORO Server (Minecraft) の稼働状態を返します。尋ねられないときは online が false です。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "online": {
                      "type": "boolean"
                    },
                    "version": {
                      "type": "string"
                    },
                    "players": {
                      "type": "object",
                      "properties": {
                        "online": {
                          "type": "integer"
                        },
                        "max": {
                          "type": "integer"
                        },
                        "names": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "motd": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/docs/save": {
      "post": {
        "summary": "Wiki ドキュメントの保存・GitHub コミット",
        "operationId": "saveWikiDoc",
        "description": "Discord 認証情報を用いて GitHub リポジトリへ直接コミットを行います。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "path",
                  "content"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "保存先のドキュメントパス。docs/ の下の .md だけで (拡張子を省くと .md になります)、Wiki のページにならないもの (docs/README.md、attachments、. で始まるもの) は保存できません。"
                  },
                  "content": {
                    "type": "string",
                    "description": "保存する Markdown 本文全体。front matter は YAML だけです。"
                  },
                  "message": {
                    "type": "string",
                    "description": "Git コミットメッセージ。1 行目の 200 文字までを使います。"
                  },
                  "sha": {
                    "type": "string",
                    "description": "既存ファイルの SHA ハッシュ（省略可）"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "保存成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "path": {
                      "type": "string"
                    },
                    "commitSha": {
                      "type": "string"
                    },
                    "contentSha": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "パスまたは本文が正しくありません"
          },
          "401": {
            "description": "Discord 認証トークンが必要です"
          },
          "403": {
            "description": "Wiki 編集権限がありません"
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "現在の認証ユーザー情報取得",
        "operationId": "getAuthMe",
        "description": "Bearer トークンの持ち主のプロフィールと権限情報を返します。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "認証ステータス",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authenticated": {
                      "type": "boolean"
                    },
                    "user": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "username": {
                          "type": "string"
                        },
                        "global_name": {
                          "type": "string",
                          "nullable": true
                        },
                        "avatar_url": {
                          "type": "string"
                        },
                        "can_edit": {
                          "type": "boolean"
                        },
                        "roles": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Discord OAuth2 認証で取得した Bearer トークン"
      }
    }
  }
}
